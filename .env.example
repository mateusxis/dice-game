# Copy to .env and adjust. docker compose reads this file automatically;
# for a local `go run ./cmd/api` export the variables yourself or use
# `make run`, which loads .env.

# --- application -----------------------------------------------------------
APP_ENV=development
HTTP_PORT=8080

# Signs JWT access tokens. Generate a real one for anything but local dev:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production-a-long-random-string
JWT_TTL=24h

# Length of each round's betting window. The spec fixes this at 15s; shorten it
# only to make manual testing less tedious.
BETTING_WINDOW=15s

# bcrypt work factor. 12 is a good production default; drop to 4-6 if local
# registration feels slow.
BCRYPT_COST=12

# Apply the embedded migrations at startup.
RUN_MIGRATIONS=true

# --- postgres --------------------------------------------------------------
POSTGRES_USER=cassino
POSTGRES_PASSWORD=cassino
POSTGRES_DB=cassino
POSTGRES_PORT=5432

# Used when the API runs on the host (not in compose). Inside compose the API
# overrides this with the `postgres` service name.
DATABASE_URL=postgres://cassino:cassino@localhost:5432/cassino?sslmode=disable

# --- redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
