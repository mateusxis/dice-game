meta {
  name: 2 - Register Player 2
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email2}}",
    "password": "{{password2}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("playerId2", res.getBody().id);
  }
}

docs {
  # Register Player 2

  Second account, used together with Player 1 for the two-player room
  walkthrough in the top-level README.

  Same request/response shape as "1 - Register Player 1".
}
